<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>

	<!-- inside the profile on purpose: an appender declared outside it opens its
	     file even when the profile is inactive, which fails wherever the path is
	     not writable -->
	<springProfile name="k8s">
		<property name="LOG_DIR" value="${LOG_DIR:-/var/log/query-echo}"/>

		<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
			<file>${LOG_DIR}/application.log</file>
			<!-- ECS json instead of a pattern: fluent-bit needs no regex parser and a
			     stack trace stays one event instead of becoming forty -->
			<encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
				<format>ecs</format>
			</encoder>
			<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
				<fileNamePattern>${LOG_DIR}/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
				<maxFileSize>100MB</maxFileSize>
				<maxHistory>7</maxHistory>
				<totalSizeCap>1GB</totalSizeCap>
				<cleanHistoryOnStart>true</cleanHistoryOnStart>
			</rollingPolicy>
		</appender>

		<!-- the request thread hands the event to a queue and returns instead of
		     waiting for the disk write. neverBlock trades completeness for latency:
		     a full queue drops events rather than stalling the caller -->
		<appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
			<appender-ref ref="FILE"/>
			<queueSize>8192</queueSize>
			<discardingThreshold>0</discardingThreshold>
			<neverBlock>true</neverBlock>
		</appender>

		<root level="INFO">
			<appender-ref ref="ASYNC_FILE"/>
		</root>
	</springProfile>

	<springProfile name="!k8s">
		<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
			<encoder>
				<pattern>${CONSOLE_LOG_PATTERN}</pattern>
			</encoder>
		</appender>

		<root level="INFO">
			<appender-ref ref="CONSOLE"/>
		</root>
	</springProfile>

</configuration>

// Deployment pipeline -- requirement 2.3. Runs ansible over SSH against the control
// plane, so this agent needs no kubeconfig and no Kubernetes RBAC of its own.
pipeline {
  agent {
    kubernetes {
      yaml '''
        apiVersion: v1
        kind: Pod
        spec:
          # the one exception to the control plane taint. on a worker this agent's own
          # 384Mi is the headroom the rollout it is driving needs, and the two deadlock
          nodeSelector:
            node-role.kubernetes.io/control-plane: ""
          tolerations:
            - key: node-role.kubernetes.io/control-plane
              operator: Exists
              effect: NoSchedule
          containers:
            - name: ansible
              image: ghcr.io/ansible-community/community-ee-minimal:2.21.3-1
              command: ["sleep"]
              args: ["9999999"]
              # the image's uid 1000 has no /etc/passwd entry, and ssh refuses to start
              # when getpwuid() fails
              securityContext:
                runAsUser: 0
              env:
                - name: HOME
                  value: /tmp
                # ansible.cfg wants the yaml callback, which this image does not carry,
                # and a missing stdout callback is fatal. only this one needs overriding
                - name: ANSIBLE_STDOUT_CALLBACK
                  value: default
              resources:
                requests: { cpu: 200m, memory: 256Mi }
                limits: { memory: 512Mi }
      '''
    }
  }

  parameters {
    string(name: 'IMAGE_TAG', defaultValue: '',
           description: 'Image tag to deploy. Empty deploys whatever k8s/app/deployment.yaml already names in git.')
  }

  environment {
    // params.X is not exported to the shell, and a single-quoted sh block does not
    // interpolate -- without this the tag arrives empty and the deploy silently skips
    IMAGE_TAG = "${params.IMAGE_TAG}"
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Deploy') {
      steps {
        container('ansible') {
          withCredentials([sshUserPrivateKey(
              credentialsId: 'vagrant-ssh',
              keyFileVariable: 'SSH_KEY_FILE')]) {
            sh '''
              cd ansible
              EXTRA=""
              if [ -n "$IMAGE_TAG" ]; then EXTRA="-e app_image_tag=$IMAGE_TAG"; fi

              ansible-playbook playbooks/08-app.yml --private-key "$SSH_KEY_FILE" $EXTRA
            '''
          }
        }
      }
    }
  }

  post {
    success {
      echo "deployed: ${params.IMAGE_TAG ?: '(image pinned in git)'}"
    }
  }
}
